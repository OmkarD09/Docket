# PayPal Developer Sandbox Credentials (US Business Account)
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# Sandbox Test Accounts (for dispute simulation & browser test automation)
PAYPAL_BUSINESS_EMAIL=your_sandbox_business_email@example.com
PAYPAL_BUSINESS_PASSWORD=your_sandbox_business_password
PAYPAL_BUYER_EMAIL=your_sandbox_buyer_email@example.com
PAYPAL_BUYER_PASSWORD=your_sandbox_buyer_password

# Optional: Specific dispute ID to inspect (e.g. PP-D-27803 or PP-R-...)
# If omitted or left blank, the script lists disputes associated with the sandbox merchant account.
PAYPAL_DISPUTE_ID=
